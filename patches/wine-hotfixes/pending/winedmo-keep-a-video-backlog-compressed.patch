From c616a1a261759ef8d044d691672456172f6d6b3f Mon Sep 17 00:00:00 2001
From: measlesbagel <49631653+measlesbagel@users.noreply.github.com>
Date: Thu, 26 Nov 2026 10:59:29 -0600
Subject: [PATCH] winedmo: Keep a video backlog compressed while another stream
 needs data.

With 0135, the demux thread keeps reading past a full video queue while
another stream's reader waits for a packet, so audio stays on time when
video is consumed slower than real time. The video read meanwhile is
decoded and queued, about 8 MB a frame at 1080p, gigabytes a minute.

Once a video stream's queue is full, keep its demuxed samples compressed
in a backlog and decode them in order as the queue drains, as Windows
decodes on demand. The end of file waits for the backlogs to drain.
---
 dlls/winedmo/wm_reader.c | 117 ++++++++++++++++++++++++++++++++++++++-
 1 file changed, 115 insertions(+), 2 deletions(-)

diff --git a/dlls/winedmo/wm_reader.c b/dlls/winedmo/wm_reader.c
index f23a3fc..d01fc8c 100644
--- a/dlls/winedmo/wm_reader.c
+++ b/dlls/winedmo/wm_reader.c
@@ -53,6 +53,7 @@ struct wm_stream
 
     /* Per-stream packet queue */
     struct list packet_queue;
+    struct list backlog; /* compressed video samples waiting for room in packet_queue */
     CRITICAL_SECTION queue_cs;
     CONDITION_VARIABLE queue_cv;
     UINT queued_packets;
@@ -156,6 +157,16 @@ struct wm_simple_buffer
     BYTE data[];
 };
 
+struct wm_backlog_sample
+{
+    struct list entry;
+    struct wm_simple_buffer *buffer;
+    DMO_OUTPUT_DATA_BUFFER output;
+    UINT stream_idx;
+    ULONG size;
+    unsigned int generation;
+};
+
 static inline struct wm_simple_buffer *wm_impl_from_IMediaBuffer(IMediaBuffer *iface)
 {
     return CONTAINING_RECORD(iface, struct wm_simple_buffer, IMediaBuffer_iface);
@@ -1006,6 +1017,7 @@ static NTSTATUS CDECL wm_stream_read_cb(struct winedmo_stream *ws, BYTE *buffer,
 
 static void wm_flush_stream_queue(struct wm_stream *stream)
 {
+    struct wm_backlog_sample *sample, *next_sample;
     struct wm_packet *pkt, *next;
 
     EnterCriticalSection(&stream->queue_cs);
@@ -1015,6 +1027,12 @@ static void wm_flush_stream_queue(struct wm_stream *stream)
         free(pkt->data);
         free(pkt);
     }
+    LIST_FOR_EACH_ENTRY_SAFE(sample, next_sample, &stream->backlog, struct wm_backlog_sample, entry)
+    {
+        list_remove(&sample->entry);
+        IMediaBuffer_Release(&sample->buffer->IMediaBuffer_iface);
+        free(sample);
+    }
     stream->queued_packets = 0;
     stream->queued_bytes = 0;
     stream->queue_eos = false;
@@ -1030,6 +1048,12 @@ static void wm_flush_stream_queue(struct wm_stream *stream)
     LeaveCriticalSection(&stream->read_cs);
 }
 
+static BOOL wm_stream_queue_full(struct wm_stream *stream)
+{
+    return stream->queued_packets >= 256
+            || (stream->queued_packets >= 4 && stream->queued_bytes >= (128 << 20));
+}
+
 /* One demux thread feeds every stream: don't let a full queue starve another one. */
 static BOOL wm_reader_other_stream_starved(struct wm_reader *reader, struct wm_stream *stream)
 {
@@ -1056,8 +1080,7 @@ static BOOL wm_stream_wait_queue_space(struct wm_reader *reader, struct wm_strea
      * unbounded. */
     EnterCriticalSection(&stream->queue_cs);
     while (!reader->demux_shutdown && !stream->queue_flushing
-            && stream->selection != WMT_OFF && (stream->queued_packets >= 256
-            || (stream->queued_packets >= 4 && stream->queued_bytes >= (128 << 20)))
+            && stream->selection != WMT_OFF && wm_stream_queue_full(stream)
             && !wm_reader_other_stream_starved(reader, stream))
         SleepConditionVariableCS(&stream->queue_cv, &stream->queue_cs, 10);
 
@@ -1071,6 +1094,69 @@ static BOOL wm_stream_wait_queue_space(struct wm_reader *reader, struct wm_strea
     return TRUE;
 }
 
+/* Decoded video is large: once a video stream's queue is full, its samples wait here
+ * compressed, so what the demux thread reads on for the other streams stays small. */
+static BOOL wm_stream_backlog_sample(struct wm_stream *s, struct wm_simple_buffer *buffer,
+        const DMO_OUTPUT_DATA_BUFFER *output, UINT stream_idx, ULONG size, unsigned int generation)
+{
+    struct wm_backlog_sample *sample;
+    BOOL queued = FALSE;
+
+    if (!IsEqualGUID(&s->major_type, &MFMediaType_Video))
+        return FALSE;
+
+    EnterCriticalSection(&s->queue_cs);
+    if ((!list_empty(&s->backlog) || wm_stream_queue_full(s)) && (sample = malloc(sizeof(*sample))))
+    {
+        sample->buffer = buffer;
+        sample->output = *output;
+        sample->stream_idx = stream_idx;
+        sample->size = size;
+        sample->generation = generation;
+        list_add_tail(&s->backlog, &sample->entry);
+        queued = TRUE;
+    }
+    LeaveCriticalSection(&s->queue_cs);
+    return queued;
+}
+
+/* Takes the oldest backlogged sample of a stream with room in its queue. A full stream
+ * waits for room, unless another stream's reader needs the demux thread to read on. */
+static struct wm_backlog_sample *wm_reader_next_backlog_sample(struct wm_reader *reader)
+{
+    struct wm_backlog_sample *sample;
+    WORD i;
+
+    for (i = 0; i < reader->stream_count; ++i)
+    {
+        struct wm_stream *s = &reader->streams[i];
+
+        if (list_empty(&s->backlog) || !wm_stream_wait_queue_space(reader, s))
+            continue;
+        sample = NULL;
+        EnterCriticalSection(&s->queue_cs);
+        if (!list_empty(&s->backlog) && !wm_stream_queue_full(s))
+        {
+            sample = LIST_ENTRY(list_head(&s->backlog), struct wm_backlog_sample, entry);
+            list_remove(&sample->entry);
+        }
+        LeaveCriticalSection(&s->queue_cs);
+        if (sample)
+            return sample;
+    }
+    return NULL;
+}
+
+static BOOL wm_reader_has_backlog(struct wm_reader *reader)
+{
+    WORD i;
+
+    for (i = 0; i < reader->stream_count; ++i)
+        if (reader->streams[i].selection != WMT_OFF && !list_empty(&reader->streams[i].backlog))
+            return TRUE;
+    return FALSE;
+}
+
 static DWORD CALLBACK wm_demux_thread(void *arg)
 {
     struct wm_reader *reader = arg;
@@ -1080,8 +1166,10 @@ static DWORD CALLBACK wm_demux_thread(void *arg)
 
     while (!reader->demux_shutdown)
     {
+        struct wm_backlog_sample *backlog;
         struct wm_simple_buffer *sbuf;
         DMO_OUTPUT_DATA_BUFFER output;
+        BOOL from_backlog = FALSE;
         UINT stream_idx, needed_size;
         NTSTATUS status;
         BYTE *src;
@@ -1097,6 +1185,18 @@ static DWORD CALLBACK wm_demux_thread(void *arg)
             continue;
         }
 
+        if ((backlog = wm_reader_next_backlog_sample(reader)))
+        {
+            sbuf = backlog->buffer;
+            output = backlog->output;
+            stream_idx = backlog->stream_idx;
+            needed_size = backlog->size;
+            read_generation = backlog->generation;
+            from_backlog = TRUE;
+            free(backlog);
+            goto have_sample;
+        }
+
         if (!(sbuf = wm_simple_buffer_create(buffer_size)))
         {
             Sleep(1);
@@ -1130,6 +1230,11 @@ static DWORD CALLBACK wm_demux_thread(void *arg)
                 Sleep(1);
                 continue; /* fake EOF from flushing, loop and wait */
             }
+            if (wm_reader_has_backlog(reader))
+            {
+                Sleep(1);
+                continue; /* decode the backlogged video before ending the streams */
+            }
             /* Real EOF: drain decoders and signal all streams */
             TRACE("Demuxer reached end of file.\n");
             for (UINT i = 0; i < reader->stream_count; i++)
@@ -1251,6 +1356,7 @@ static DWORD CALLBACK wm_demux_thread(void *arg)
             continue;
         }
 
+have_sample:
         if (read_generation != reader->read_flush_generation || reader->read_flushing)
         {
             IMediaBuffer_Release(&sbuf->IMediaBuffer_iface);
@@ -1292,6 +1398,12 @@ static DWORD CALLBACK wm_demux_thread(void *arg)
             UINT32 dec_size = winedmo_format_get_max_size(&s->decoded_winedmo_format);
             NTSTATUS dec_status;
 
+            if (!from_backlog && wm_stream_backlog_sample(s, sbuf, &output, stream_idx, data_len, read_generation))
+            {
+                LeaveCriticalSection(&s->decoder_cs);
+                continue;
+            }
+
             if (!dec_size) dec_size = 0x40000;
             if ((in_flags & WINEDMO_SAMPLE_FLAG_SYNC_POINT) && IsEqualGUID(&s->major_type, &MFMediaType_Video))
                 s->next_decoded_cleanpoint = true;
@@ -2347,6 +2459,7 @@ static HRESULT init_stream(struct wm_reader *reader)
         stream->reader = reader;
         stream->index = i;
         list_init(&stream->packet_queue);
+        list_init(&stream->backlog);
         InitializeCriticalSection(&stream->queue_cs);
         InitializeCriticalSection(&stream->read_cs);
         InitializeConditionVariable(&stream->queue_cv);
-- 
2.53.0

