-                    if (IsEqualGUID(&s->major_type, &MFMediaType_Video))
-                        pkt->flags |= WM_SF_CLEANPOINT;
-                    if (dec_flags & WINEDMO_SAMPLE_FLAG_SYNC_POINT) pkt->flags |= WM_SF_CLEANPOINT;
-                    if (s->next_decoded_cleanpoint)
